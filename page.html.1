<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        p{
            color: rgb(15, 2, 92);
            font-style: italic;
        }

        .hema{
            color: brown;
            font-variant;
        }
        #bhanu{
            color: aqua;
            font-display: block;
        }
        *{
            background-color: #FF5CFF;
            font-variant-numeric: if(23);
        }
        i,del,b{
            color: blue;
        }

    </style>
</head>
<body>
    <b>boldtext</b><br>
    <strong>important text</strong><br>
    <i>italic text</i><br>
     <u>underlined text</u><br>
     <mark class="hema">highlighted text</mark>
     <p><small>small text</small></p>
     <p>h<sub>2</sub></p>
     <p>x<sub>2</sub></p>
     <del>delete</del><br>
     <marquee id="hema"></marquee><br>
     
     <img scr="god.jpg" alt="my image" height="200" width="400"><br>
     <pre>
        here is the example of webpage.
                 thanking you
     </pre>
     </body>
</html>